{
    "theme": "dark",
    "current_language": "python",
    "editor": {
        "font_family": "Consolas",
        "font_size": 12,
        "show_line_numbers": true,
        "word_wrap": false
    },
    "autocomplete": {
        "enabled": true,
        "delay": 200
    },
    "intelicode": {
        "enabled": true,
        "max_suggestions": 60
    },
    "python": {
        "auto_imports": true
    },
    "venv": {
        "auto_create": true,
        "auto_install": true,
        "use_for_run": true,
        "path": ".venv",
        "requirements": "requirements.txt"
    },
    "languages": {
        "lua": { "path": "" },
        "python": { "path": "" },
        "javascript": { "path": "" },
        "ruby": { "path": "" },
        "php": { "path": "" },
        "perl": { "path": "" },
        "cpp": { "path": "" },
        "html": { "path": "" }
    },
    "workspace": {
        "root_path": "",
        "open_files": [],
        "active_file": "",
        "terminal_history": []
    },
    "recent_folders": [],
    "window": {
        "width": 1400,
        "height": 900,
        "maximized": false
    },
    "openai": {
        "api_key": "",
        "model": ""
    }
}
